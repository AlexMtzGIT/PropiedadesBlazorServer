@page "/editar-categoria/{Id:int}"
@using PropiedadesBlazor.Modelos.DTO
@using PropiedadesBlazor.Repositorio
@using PropiedadesBlazor.Repositorio.IRepositorio
@inject ICategoriaRepositorio CategoriaRepositorio
@inject NavigationManager navigationManager

<h1 class="text-center">Editar Categoria</h1>


<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-7">
                <h2 class="text-dark">Editar Categoria Existente</h2>
            </div>
        </div>
    </div>
    <div class="card-body">
        <EditForm Model="categoriaDTO" OnValidSubmit="@(() => ManejadorOnEditarCategoria())">
            <!--llamamos al metodo/funcion "ManejadorOnCrearCategoria" que se creó en la parte inferior -->
            <DataAnnotationsValidator></DataAnnotationsValidator>
            <ValidationSummary></ValidationSummary>
            <div class="container">
                <div class="form-group">
                    <div class="row">
                        <div class="col-2">
                            <!--esta columna ocupa 2-->
                            <label>Nombre: </label>
                        </div>
                        <div class="col-6">
                            <!--esta columna ocupa 6-->
                            <InputText @bind-Value="categoriaDTO.NombreCategoria" class="form-control" placeholder="Ingresa el nombre"></InputText>
                            <ValidationMessage For="() => categoriaDTO.NombreCategoria"></ValidationMessage>
                        </div>
                    </div>
                </div>
                <br />

                <div class="form-group">
                    <div class="row">
                        <div class="col-2"><!--esta columna ocupa 2-->
                            <label>Descripción: </label>
                        </div>
                        <div class="col-6"><!--esta columna ocupa 6-->
                            <InputText @bind-Value="categoriaDTO.Descripcion" class="form-control" placeholder="Ingresa la descripción"></InputText>
                            <ValidationMessage For="() => categoriaDTO.Descripcion"></ValidationMessage>
                        </div>
                    </div>
                </div>
                <br />

                <div class="form-group">
                    <div class="row">
                        <div class="col-2">
                            <!--esta columna ocupa 2-->
                            <button type="submit" class="btn btn-success"><i class="bi bi-gear-fill"></i>&nbsp; Guardar Categoria</button>
                        </div>
                        <div class="col-6">
                            <!--esta columna ocupa 6-->
                            <NavLink href="categorias" class="btn btn-secondary"><i class="bi bi-arrow-left-circle-fill"></i>&nbsp; Volver atrás</NavLink>
                        </div>
                    </div>
                </div>
                <br />

            </div>
        </EditForm>
    </div>
</div>



@code {
    [Parameter]
    public int? Id { get; set; }

    private CategoriaDTO categoriaDTO { get; set; } = new CategoriaDTO();

    protected override async Task OnInitializedAsync()//Metodo que cuando da click en "Editar", vaya a un formulario aparte y nos muestre los campos
    {
        if(Id != null)
        {
            categoriaDTO = await CategoriaRepositorio.GetCategoria(Id.Value); //aqui utilizamos el metodo que nos trae una categoria en especifico "GetCategoria"
        }

    }

    private async Task ManejadorOnEditarCategoria()
    {

        try
        {
            var nombreCategoria = await CategoriaRepositorio.NombreCategoriaExiste(categoriaDTO.NombreCategoria);
            if (nombreCategoria != null)
            {
                return;
            }

            //Si pasa por aqui entonces no existe el nombre (no es duplicado) y se puede actualizar
            var editarCategoria = await CategoriaRepositorio.ActualizarCategoria(categoriaDTO.Id, categoriaDTO); //creamos una variable editarCategoria, donde utilizamos a "CategoriaRepositorio.cs", la cual tiene el metodo "ActualizarCategoria" al cual tambien llamamos y le pasamos el Id de la categoria y el modelo "categoriaDTO" (como lo pusimos en el ICategoriaRepositorio, recibe ambos)
            navigationManager.NavigateTo("categorias");

        }
        catch (Exception ex)
        {
            
            return;
        }
    }

}
